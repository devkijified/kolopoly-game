# Asset cache. HTML, the service worker and unversioned app files stay
# fresh; versioned static files (?v=<build>) are marked immutable by the
# worker / Node server. These rules are the fallback for direct assets.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/tex/*
  Cache-Control: public, max-age=31536000, immutable
/sfx/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/app.js
  Cache-Control: no-cache
/style.css
  Cache-Control: no-cache
/premium.css
  Cache-Control: no-cache
/update.js
  Cache-Control: no-cache
/retention.js
  Cache-Control: no-cache
/board.js
  Cache-Control: no-cache
/board3d.js
  Cache-Control: no-cache
/game-data.js
  Cache-Control: no-cache
/game-feel.js
  Cache-Control: no-cache
/icons.js
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-store
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
