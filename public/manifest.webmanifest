{
  "name": "Kolopoly",
  "short_name": "Kolopoly",
  "description": "Buy Lagos street by street. Dodge Kirikiri. Catch the Owambe pot.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "display": "standalone",
  "background_color": "#f5efe2",
  "theme_color": "#f5efe2",
  "lang": "en",
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "https://kolopoly.fun/manifest.webmanifest" }
  ],
  "icons": [
    { "src": "/icons/icon-192.png?v=__KOLOPOLY_BUILD__", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png?v=__KOLOPOLY_BUILD__", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512-maskable.png?v=__KOLOPOLY_BUILD__", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
